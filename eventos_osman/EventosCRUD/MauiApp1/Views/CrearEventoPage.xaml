<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MauiApp1.Views"
             x:Class="MauiApp1.Views.CrearEventoPage"
             Title="Crear Evento">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <!-- Encabezado -->
            <Label Text="Nuevo Evento"
                   FontSize="22"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <!-- Campo título -->
            <Entry x:Name="tituloEntry"
                   Placeholder="Título del evento"
                   BackgroundColor="#ffffff"
                   TextColor="Black" />

            <!-- Campo descripción -->
            <Editor x:Name="descripcionEditor"
                    Placeholder="Descripción del evento"
                    AutoSize="TextChanges"
                    BackgroundColor="#ffffff"
                    TextColor="Black" />

            <!-- Fecha y hora de inicio -->
            <Label Text="Fecha y hora de inicio" FontAttributes="Bold" />
            <DatePicker x:Name="fechaInicioPicker" />
            <TimePicker x:Name="horaInicioPicker" />

            <!-- Fecha y hora de fin -->
            <Label Text="Fecha y hora de fin" FontAttributes="Bold" />
            <DatePicker x:Name="fechaFinPicker" />
            <TimePicker x:Name="horaFinPicker" />

            <!-- Etiquetas -->
            <Label Text="Etiquetas disponibles" FontAttributes="Bold" />
            <Picker x:Name="etiquetasPicker"
                    Title="Selecciona una etiqueta"
                    SelectedIndexChanged="OnEtiquetaSeleccionada" />

            <!-- Panel para crear nueva etiqueta -->
            <StackLayout x:Name="crearEtiquetaPanel"
                         IsVisible="False"
                         Spacing="10">
                <Entry x:Name="nuevaEtiquetaEntry"
                       Placeholder="Nueva etiqueta"
                       BackgroundColor="#ffffff"
                       TextColor="Black" />
                <Button Text="Agregar"
                        Clicked="OnAgregarEtiquetaClicked"
                        BackgroundColor="#9C27B0"
                        TextColor="White"
                        CornerRadius="8" />
            </StackLayout>

            <!-- Etiquetas seleccionadas -->
            <Label Text="Etiquetas seleccionadas" FontAttributes="Bold" />
            <CollectionView x:Name="etiquetasSeleccionadasView"
                            ItemsSource="{Binding EtiquetasSeleccionadas}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Padding="10" Margin="5"
                               BackgroundColor="#eeeeee"
                               CornerRadius="10"
                               BorderColor="Gray"
                               HorizontalOptions="FillAndExpand">
                            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                <Label Grid.Column="0"
                                       Text="{Binding .}"
                                       FontSize="14"
                                       TextColor="Black"
                                       VerticalOptions="Center" />
                                <ImageButton Grid.Column="1"
                                             Source="delete.png"
                                             HeightRequest="24"
                                             WidthRequest="24"
                                             BackgroundColor="Transparent"
                                             Command="{Binding Source={RelativeSource AncestorType={x:Type local:CrearEventoPage}}, Path=EliminarEtiquetaCommand}"
                                             CommandParameter="{Binding .}" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Botón Crear -->
            <Button Text="Crear Evento"
                    Clicked="OnCrearClicked"
                    BackgroundColor="#4CAF50"
                    TextColor="White"
                    CornerRadius="10"
                    AutomationProperties.Name="Botón Crear Evento" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>