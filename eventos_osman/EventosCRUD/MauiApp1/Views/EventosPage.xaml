<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Views.EventosPage"
             Title="Eventos">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <!-- Encabezado -->
            <Label Text="Lista de eventos"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <!-- Botón para agregar nuevo evento -->
            <Button Text="Agregar Evento"
                    Clicked="OnAgregarEventoClicked"
                    BackgroundColor="#4CAF50"
                    TextColor="White"
                    CornerRadius="10"
                    HorizontalOptions="Center"
                    WidthRequest="200" />

            <!-- Lista de eventos con scroll -->
            <CollectionView x:Name="eventosView"
                            ItemsSource="{Binding Eventos}"
                            VerticalOptions="FillAndExpand">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Padding="10" Margin="5"
                               BackgroundColor="MediumPurple"
                               BorderColor="Gray"
                               CornerRadius="10">
                            <VerticalStackLayout Spacing="5">
                                <Label Text="{Binding Titulo}" FontSize="18" FontAttributes="Bold" />
                                <Label Text="{Binding Descripcion}" FontSize="14" />
                                <Label Text="{Binding FechaInicio}" FontSize="12" TextColor="Gray" />
                                <Label Text="{Binding FechaFin}" FontSize="12" TextColor="Gray" />

                                <HorizontalStackLayout Spacing="10" HorizontalOptions="End">
                                    <Button Text="Editar"
                                            BackgroundColor="#9C27B0"
                                            TextColor="White"
                                            Clicked="OnEditarEventoClicked"
                                            CommandParameter="{Binding}" />
                                    <Button Text="Eliminar"
                                            BackgroundColor="#F44336"
                                            TextColor="White"
                                            Clicked="OnEliminarEventoClicked"
                                            CommandParameter="{Binding}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>