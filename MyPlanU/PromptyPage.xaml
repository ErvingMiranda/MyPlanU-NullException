<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MyPlanU.PromptyPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="PROMPTY">

    <Grid RowDefinitions="*,Auto" Padding="16">

        <!-- Lista de mensajes -->
        <CollectionView
            x:Name="MensajesList"
            Grid.Row="0"
            ItemsSource="{Binding Mensajes}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame
                        Margin="0,4"
                        Padding="8"
                        HasShadow="False"
                        CornerRadius="10"
                        BackgroundColor="#222222">
                        <VerticalStackLayout>
                            <Label
                                Text="{Binding Rol}"
                                FontAttributes="Bold"
                                FontSize="12"
                                TextColor="#AAAAAA" />
                            <Label
                                Text="{Binding Texto}"
                                FontSize="14"
                                TextColor="White"
                                LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Caja de texto + botón enviar -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Entry
                x:Name="MensajeEntry"
                Grid.Column="0"
                Placeholder="Escribe un mensaje para PROMPTY..."
                ReturnType="Send"
                Completed="OnSendCompleted" />

            <Button
                x:Name="SendButton"
                Grid.Column="1"
                Text="Enviar"
                Clicked="OnSendClicked" />
        </Grid>
    </Grid>
</ContentPage>
