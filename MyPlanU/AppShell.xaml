<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MyPlanU.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MyPlanU">

    <TabBar>
        <ShellContent
            Title="Home"
            ContentTemplate="{DataTemplate local:MainPage}" />

        <ShellContent
            Title="PROMPTY"
            Route="prompty"
            ContentTemplate="{DataTemplate local:PromptyPage}" />
    </TabBar>

</Shell>
