<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MyPlanU.App.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="MyPlanU.App.Pages.PromptyPage"
             Title="PROMPTY">

    <ContentPage.Resources>
        <ResourceDictionary>
            <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto,Auto" Padding="16">
        
        <!-- Header explicativo PROMPTY Lite -->
        <Frame Grid.Row="0" BackgroundColor="#333333" Padding="10" Margin="0,0,0,10" CornerRadius="8" HasShadow="False">
            <Label Text="Esta es la versión PROMPTY Lite: podés hacer preguntas y recibir sugerencias, pero no se crearán eventos ni tareas automáticamente. Para agendar algo, usá las pantallas normales de MyPlanU."
                   TextColor="#DDDDDD"
                   FontSize="12"
                   HorizontalTextAlignment="Center" />
        </Frame>

        <CollectionView x:Name="MessagesCollectionView" Grid.Row="1" ItemsSource="{Binding Mensajes}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Margin="0,4" Padding="8" HasShadow="False" CornerRadius="10" BackgroundColor="#222222">
                        <VerticalStackLayout>
                            <Label Text="{Binding Rol}" FontAttributes="Bold" FontSize="12" TextColor="#AAAAAA" />
                            <Label Text="{Binding Texto}" FontSize="14" TextColor="White" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,0,10">
            <Entry Grid.Column="0" Text="{Binding MensajeEntrada}" Placeholder="Escribe un mensaje..." ReturnType="Send" />
            <Button Grid.Column="1" Text="Enviar" Command="{Binding EnviarMensajeCommand}" />
        </Grid>

        <Button Grid.Row="3" 
                Text="Abrir PROMPTY completo" 
                Command="{Binding StartGuiCommand}"
                BackgroundColor="#444444"
                TextColor="White"
                HorizontalOptions="Fill" />
    </Grid>
</ContentPage>
