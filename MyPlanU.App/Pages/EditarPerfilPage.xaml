<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MyPlanU.App.ViewModels"
             x:Class="MyPlanU.App.Pages.EditarPerfilPage"
             Title="Editar Perfil"
             Style="{StaticResource BasePageStyle}"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <Grid Padding="30">
            <VerticalStackLayout Spacing="20" VerticalOptions="Center">

                <Grid ColumnDefinitions="Auto, *" VerticalOptions="Center" Margin="0,0,0,10">
                    <Button Text="❮" 
                            TextColor="White"
                            BackgroundColor="#30000000"
                            CornerRadius="20"
                            HeightRequest="40"
                            WidthRequest="40"
                            Padding="0"
                            FontSize="20"
                            Command="{Binding GoBackCommand}" 
                            HorizontalOptions="Start"
                            VerticalOptions="Center"
                            ZIndex="1"/>
                            
                    <Label Text="Editar Perfil"
                           Grid.Column="0" Grid.ColumnSpan="2"
                           FontSize="28" 
                           FontAttributes="Bold" 
                           HorizontalOptions="Center" 
                           VerticalOptions="Center"
                           TextColor="White" />
                </Grid>

                <Frame BackgroundColor="#50000000"
                       CornerRadius="20"
                       Padding="20">

                    <VerticalStackLayout Spacing="15">

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Nombre" TextColor="White" FontSize="14" FontAttributes="Bold"/>
                            <Entry Placeholder="Nombre"
                                   Text="{Binding Nombre}"
                                   TextColor="White"
                                   PlaceholderColor="#E0E0E0"
                                   BackgroundColor="Transparent" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Apellido" TextColor="White" FontSize="14" FontAttributes="Bold"/>
                            <Entry Placeholder="Apellido"
                                   Text="{Binding Apellido}"
                                   TextColor="White"
                                   PlaceholderColor="#E0E0E0"
                                   BackgroundColor="Transparent" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Apodo" TextColor="White" FontSize="14" FontAttributes="Bold"/>
                            <Entry Placeholder="Apodo"
                                   Text="{Binding Apodo}"
                                   TextColor="White"
                                   PlaceholderColor="#E0E0E0"
                                   BackgroundColor="Transparent" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="País" TextColor="White" FontSize="14" FontAttributes="Bold"/>
                            <Entry Placeholder="País"
                                   Text="{Binding Pais}"
                                   TextColor="White"
                                   PlaceholderColor="#E0E0E0"
                                   BackgroundColor="Transparent" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Zona Horaria" TextColor="White" FontSize="14" FontAttributes="Bold"/>
                            <Entry Placeholder="Zona Horaria"
                                   Text="{Binding ZonaHoraria}"
                                   TextColor="White"
                                   PlaceholderColor="#E0E0E0"
                                   BackgroundColor="Transparent" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Pregunta de Seguridad" TextColor="White" FontSize="14" FontAttributes="Bold"/>
                            <Picker Title="Selecciona una pregunta"
                                    TitleColor="#E0E0E0"
                                    TextColor="White"
                                    BackgroundColor="Transparent"
                                    ItemsSource="{Binding PreguntasDisponibles}"
                                    SelectedItem="{Binding PreguntaSeguridad}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Respuesta de Seguridad (Dejar vacío para no cambiar)" TextColor="White" FontSize="14" FontAttributes="Bold"/>
                            <Entry Placeholder="Nueva respuesta"
                                   Text="{Binding RespuestaSeguridad}"
                                   TextColor="White"
                                   PlaceholderColor="#E0E0E0"
                                   BackgroundColor="Transparent" />
                        </VerticalStackLayout>

                        <Button Text="Guardar"
                                Command="{Binding SaveCommand}"
                                BackgroundColor="#5e17eb"
                                TextColor="White"
                                CornerRadius="25"
                                HeightRequest="48"
                                Margin="0,20,0,0" />

                    </VerticalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
