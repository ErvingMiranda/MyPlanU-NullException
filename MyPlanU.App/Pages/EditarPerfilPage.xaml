<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MyPlanU.App.ViewModels"
             x:Class="MyPlanU.App.Pages.EditarPerfilPage"
             Title="Editar Perfil"
             Style="{StaticResource BasePageStyle}"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <Grid Padding="30">
            <VerticalStackLayout Spacing="20" VerticalOptions="Center">

                <Grid ColumnDefinitions="Auto, *" VerticalOptions="Center" Margin="0,0,0,10">
                    <Button Text="❮" 
                            TextColor="White"
                            BackgroundColor="#30000000"
                            CornerRadius="20"
                            HeightRequest="40"
                            WidthRequest="40"
                            Padding="0"
                            FontSize="20"
                            Command="{Binding GoBackCommand}" 
                            HorizontalOptions="Start"
                            VerticalOptions="Center"
                            ZIndex="1"/>
                            
                    <Label Text="Editar Perfil"
                           Grid.Column="0" Grid.ColumnSpan="2"
                           FontSize="28" 
                           FontAttributes="Bold" 
                           HorizontalOptions="Center" 
                           VerticalOptions="Center"
                           TextColor="White" />
                </Grid>

                <Frame BackgroundColor="#50000000"
                       CornerRadius="20"
                       Padding="20">

                    <VerticalStackLayout Spacing="15">

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Nombre" TextColor="White" FontSize="14" FontAttributes="Bold"/>
                            <Entry Placeholder="Nombre"
                                   Text="{Binding Nombre}"
                                   TextColor="White"
                                   PlaceholderColor="#E0E0E0"
                                   BackgroundColor="Transparent" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Apellido" TextColor="White" FontSize="14" FontAttributes="Bold"/>
                            <Entry Placeholder="Apellido"
                                   Text="{Binding Apellido}"
                                   TextColor="White"
                                   PlaceholderColor="#E0E0E0"
                                   BackgroundColor="Transparent" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Apodo" TextColor="White" FontSize="14" FontAttributes="Bold"/>
                            <Entry Placeholder="Apodo"
                                   Text="{Binding Apodo}"
                                   TextColor="White"
                                   PlaceholderColor="#E0E0E0"
                                   BackgroundColor="Transparent" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="País" TextColor="White" FontSize="14" FontAttributes="Bold"/>
                            <Entry Placeholder="País"
                                   Text="{Binding Pais}"
                                   TextColor="White"
                                   PlaceholderColor="#E0E0E0"
                                   BackgroundColor="Transparent" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Pregunta de Seguridad" TextColor="White" FontSize="14" FontAttributes="Bold"/>
                            <Border Stroke="#2fffa3" 
                                    StrokeThickness="1" 
                                    StrokeShape="RoundRectangle 10" 
                                    BackgroundColor="#20FFFFFF" 
                                    HeightRequest="50"
                                    Padding="0">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleQuestionsDropdownCommand}" />
                                </Border.GestureRecognizers>
                                <Border.Shadow>
                                    <Shadow Brush="Black" Offset="2,2" Opacity="0.2" Radius="5"/>
                                </Border.Shadow>
                                <Grid ColumnDefinitions="*, 50">
                                    <Label Grid.Column="0" 
                                           Text="{Binding PreguntaSeguridad, TargetNullValue='Selecciona una pregunta'}"
                                           VerticalOptions="Center" 
                                           Margin="15,0"
                                           TextColor="White"
                                           LineBreakMode="TailTruncation">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding PreguntaSeguridad}" Value="{x:Null}">
                                                <Setter Property="TextColor" Value="#E0E0E0" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Grid Grid.Column="1" BackgroundColor="Black">
                                        <Label Text="▼" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" FontSize="12"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Custom Dropdown List -->
                            <Border IsVisible="{Binding IsQuestionsDropdownVisible}"
                                    Stroke="#2fffa3"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 10"
                                    BackgroundColor="#202020"
                                    MaximumHeightRequest="200"
                                    Padding="0"
                                    Margin="0,-5,0,0"
                                    ZIndex="100">
                                <CollectionView ItemsSource="{Binding PreguntasDisponibles}"
                                                VerticalScrollBarVisibility="Always">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="15,10" BackgroundColor="Transparent" ColumnDefinitions="*, Auto">
                                                <Grid.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:EditarPerfilViewModel}}, Path=SelectQuestionCommand}"
                                                                          CommandParameter="{Binding .}" />
                                                </Grid.GestureRecognizers>
                                                <Label Grid.Column="0" Text="{Binding .}" TextColor="White" FontSize="14" VerticalOptions="Center" />
                                                <Button Grid.Column="1" 
                                                        Text="✕" 
                                                        TextColor="#FF6B6B" 
                                                        BackgroundColor="Transparent" 
                                                        FontSize="12"
                                                        HeightRequest="30"
                                                        WidthRequest="30"
                                                        Padding="0"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:EditarPerfilViewModel}}, Path=EliminarPreguntaDisponibleCommand}"
                                                        CommandParameter="{Binding .}">
                                                    <Button.Triggers>
                                                        <DataTrigger TargetType="Button" Binding="{Binding .}" Value="Escribir mi propia pregunta...">
                                                            <Setter Property="IsVisible" Value="False" />
                                                        </DataTrigger>
                                                    </Button.Triggers>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="5" IsVisible="{Binding IsCustomQuestionVisible}">
                            <Label Text="Escribe tu pregunta" TextColor="White" FontSize="14" FontAttributes="Bold"/>
                            <Entry Placeholder="¿Cuál es tu pregunta?"
                                   TextColor="White"
                                   PlaceholderColor="#E0E0E0"
                                   BackgroundColor="Transparent"
                                   Text="{Binding PreguntaPersonalizada}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Respuesta de Seguridad (Dejar vacío para no cambiar)" TextColor="White" FontSize="14" FontAttributes="Bold"/>
                            <Entry Placeholder="Nueva respuesta"
                                   Text="{Binding RespuestaSeguridad}"
                                   TextColor="White"
                                   PlaceholderColor="#E0E0E0"
                                   BackgroundColor="Transparent" />
                        </VerticalStackLayout>

                        <Button Text="Guardar"
                                Command="{Binding SaveCommand}"
                                BackgroundColor="#5e17eb"
                                TextColor="White"
                                CornerRadius="25"
                                HeightRequest="48"
                                Margin="0,20,0,0" />

                    </VerticalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
