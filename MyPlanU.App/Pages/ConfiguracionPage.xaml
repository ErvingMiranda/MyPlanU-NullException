<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MyPlanU.App.ViewModels"
             x:Class="MyPlanU.App.Pages.ConfiguracionPage"
             Title="Configuración"
             Style="{StaticResource BasePageStyle}">

    <ScrollView>
        <Grid Padding="20">
            <VerticalStackLayout Spacing="20">
                <Label Text="Ajustes" 
                       FontSize="34" 
                       FontAttributes="Bold" 
                       HorizontalOptions="Center" 
                       TextColor="{AppThemeBinding Light=Black, Dark=White}" />

                <Frame BackgroundColor="{AppThemeBinding Light=White, Dark=#50000000}" 
                       CornerRadius="20" 
                       Padding="20"
                       BorderColor="{AppThemeBinding Light=#E0E0E0, Dark=Transparent}"
                       HasShadow="{AppThemeBinding Light=True, Dark=False}">
                    <VerticalStackLayout Spacing="15">
                        <Label Text="General" TextColor="{AppThemeBinding Light=#5e17eb, Dark=#2fffa3}" FontAttributes="Bold" FontSize="18"/>
                        
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="Notificaciones" TextColor="{AppThemeBinding Light=Black, Dark=White}" VerticalOptions="Center"/>
                            <Switch Grid.Column="1" OnColor="#2fffa3" ThumbColor="White" IsToggled="{Binding IsNotificacionesEnabled}"/>
                        </Grid>
                        
                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E0E0E0, Dark=#30FFFFFF}"/>

                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="Modo Oscuro" TextColor="{AppThemeBinding Light=Black, Dark=White}" VerticalOptions="Center"/>
                            <Switch Grid.Column="1" OnColor="#2fffa3" ThumbColor="White" IsToggled="{Binding IsModoOscuroEnabled}"/>
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <Frame BackgroundColor="{AppThemeBinding Light=White, Dark=#50000000}" 
                       CornerRadius="20" 
                       Padding="20"
                       BorderColor="{AppThemeBinding Light=#E0E0E0, Dark=Transparent}"
                       HasShadow="{AppThemeBinding Light=True, Dark=False}">
                    <VerticalStackLayout Spacing="15">
                        <Label Text="Cuenta" TextColor="{AppThemeBinding Light=#5e17eb, Dark=#2fffa3}" FontAttributes="Bold" FontSize="18"/>
                        
                        <Button Text="Editar Perfil" 
                                BackgroundColor="Transparent" 
                                TextColor="{AppThemeBinding Light=Black, Dark=White}" 
                                HorizontalOptions="Start" 
                                BorderColor="{AppThemeBinding Light=Black, Dark=White}" 
                                BorderWidth="1" 
                                CornerRadius="20"
                                HeightRequest="40"
                                Command="{Binding EditarPerfilCommand}"/>

                        <Button Text="Cambiar Contraseña" 
                                BackgroundColor="Transparent" 
                                TextColor="{AppThemeBinding Light=Black, Dark=White}" 
                                HorizontalOptions="Start" 
                                BorderColor="{AppThemeBinding Light=Black, Dark=White}" 
                                BorderWidth="1" 
                                CornerRadius="20"
                                HeightRequest="40"
                                Command="{Binding CambiarPasswordCommand}"/>
                    </VerticalStackLayout>
                </Frame>

                <Button Text="Cerrar Sesión" 
                        BackgroundColor="#FF6B6B" 
                        TextColor="White" 
                        CornerRadius="25" 
                        HeightRequest="50" 
                        Margin="0,20,0,0"
                        Command="{Binding CerrarSesionCommand}"/>

            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
