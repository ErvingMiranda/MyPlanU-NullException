<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MyPlanU.App.ViewModels"
             x:Class="MyPlanU.App.Pages.RegistroPage"
             Title="Registro"
             Style="{StaticResource BasePageStyle}"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <Grid Padding="30">
            <VerticalStackLayout 
                Spacing="15" 
                VerticalOptions="Center">

                <!-- Contenido centrado encima del fondo -->
                <Grid Padding="30">
                    <VerticalStackLayout
                      Spacing="15"
                      VerticalOptions="Center">

                        <!-- Contenido centrado encima del fondo -->
                        <Grid Padding="30">
                            <!-- Dos filas: logo en la parte superior (auto) y contenido centrado en el resto -->
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Image Source="{AppThemeBinding Light=mylogo.png, Dark=mylogowhite.png}"
                                   Grid.Row="0"
                                   HeightRequest="200"
                                   WidthRequest="200"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Start"
                                   Margin="0,0,0,10" />

                            <VerticalStackLayout
                                Grid.Row="1"
                                Spacing="15"
                                VerticalOptions="Center">

                                <Grid ColumnDefinitions="Auto, *" VerticalOptions="Center" Margin="0,0,0,10">
                                    <Button Text="❮" 
                                            TextColor="White"
                                            BackgroundColor="#30000000"
                                            CornerRadius="20"
                                            HeightRequest="40"
                                            WidthRequest="40"
                                            Padding="0"
                                            FontSize="20"
                                            Command="{Binding GoBackCommand}" 
                                            HorizontalOptions="Start"
                                            VerticalOptions="Center"
                                            ZIndex="1"/>
                                            
                                    <Label Text="Crear Cuenta"
                                           Grid.Column="0" Grid.ColumnSpan="2"
                                           FontSize="34"
                                           FontAttributes="Bold"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"
                                           TextColor="White" />
                                </Grid>

                                <Frame BackgroundColor="#50000000"
                                       CornerRadius="20"
                                       Padding="20">

                                    <VerticalStackLayout Spacing="15">

                                        <VerticalStackLayout Spacing="5">
                                            <Label Text="Nombre" TextColor="White" FontSize="14" FontAttributes="Bold"/>
                                            <Entry x:Name="NombreEntry"
                                                   Placeholder="Tu nombre"
                                                   TextColor="White"
                                                   PlaceholderColor="#E0E0E0"
                                                   BackgroundColor="Transparent"
                                                   Text="{Binding Nombre}" />
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Spacing="5">
                                            <Label Text="Correo" TextColor="White" FontSize="14" FontAttributes="Bold"/>
                                            <Entry x:Name="EmailEntry"
                                                   Placeholder="tu@correo.com"
                                                   Keyboard="Email"
                                                   TextColor="White"
                                                   PlaceholderColor="#E0E0E0"
                                                   BackgroundColor="Transparent"
                                                   Text="{Binding Email}" />
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Spacing="5">
                                            <Label Text="Contraseña" TextColor="White" FontSize="14" FontAttributes="Bold"/>
                                            <Grid ColumnDefinitions="*,Auto">
                                                <Entry x:Name="PasswordEntry"
                                                       Grid.Column="0"
                                                       Placeholder="Contraseña"
                                                       IsPassword="{Binding IsPasswordHidden}"
                                                       TextColor="White"
                                                       PlaceholderColor="#E0E0E0"
                                                       BackgroundColor="Transparent"
                                                       Text="{Binding Password}" />
                                                <Button Grid.Column="1"
                                                        Text="Ver"
                                                        Command="{Binding TogglePasswordVisibilityCommand}"
                                                        BackgroundColor="#5e17eb"
                                                        TextColor="White"
                                                        CornerRadius="8"
                                                        HeightRequest="36"
                                                        WidthRequest="60"
                                                        Padding="0"
                                                        FontSize="13"
                                                        FontAttributes="Bold"
                                                        VerticalOptions="Center"
                                                        Margin="8,0,0,0">
                                                    <Button.Triggers>
                                                        <DataTrigger TargetType="Button" Binding="{Binding IsPasswordHidden}" Value="False">
                                                            <Setter Property="Text" Value="Ocultar" />
                                                        </DataTrigger>
                                                    </Button.Triggers>
                                                </Button>
                                            </Grid>
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Spacing="5">
                                            <Label Text="Pregunta de Seguridad" TextColor="White" FontSize="14" FontAttributes="Bold"/>
                                            <Border Stroke="#2fffa3" 
                                                    StrokeThickness="1" 
                                                    StrokeShape="RoundRectangle 10" 
                                                    BackgroundColor="#20FFFFFF" 
                                                    HeightRequest="50"
                                                    Padding="0">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding ToggleQuestionsDropdownCommand}" />
                                                </Border.GestureRecognizers>
                                                <Border.Shadow>
                                                    <Shadow Brush="Black" Offset="2,2" Opacity="0.2" Radius="5"/>
                                                </Border.Shadow>
                                                <Grid ColumnDefinitions="*, 50">
                                                    <Label Grid.Column="0" 
                                                           Text="{Binding PreguntaSeguridad, TargetNullValue='Selecciona una pregunta'}"
                                                           VerticalOptions="Center" 
                                                           Margin="15,0"
                                                           TextColor="White"
                                                           LineBreakMode="TailTruncation">
                                                        <Label.Triggers>
                                                            <DataTrigger TargetType="Label" Binding="{Binding PreguntaSeguridad}" Value="{x:Null}">
                                                                <Setter Property="TextColor" Value="#E0E0E0" />
                                                            </DataTrigger>
                                                        </Label.Triggers>
                                                    </Label>
                                                    <Grid Grid.Column="1" BackgroundColor="Black">
                                                        <Label Text="▼" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" FontSize="12"/>
                                                    </Grid>
                                                </Grid>
                                            </Border>

                                            <!-- Custom Dropdown List -->
                                            <Border IsVisible="{Binding IsQuestionsDropdownVisible}"
                                                    Stroke="#2fffa3"
                                                    StrokeThickness="1"
                                                    StrokeShape="RoundRectangle 10"
                                                    BackgroundColor="#202020"
                                                    MaximumHeightRequest="200"
                                                    Padding="0"
                                                    Margin="0,-5,0,0"
                                                    ZIndex="100">
                                                <CollectionView ItemsSource="{Binding PreguntasDisponibles}"
                                                                VerticalScrollBarVisibility="Always">
                                                    <CollectionView.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Padding="15,10" BackgroundColor="Transparent" ColumnDefinitions="*, Auto">
                                                                <Grid.GestureRecognizers>
                                                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RegistroViewModel}}, Path=SelectQuestionCommand}"
                                                                                          CommandParameter="{Binding .}" />
                                                                </Grid.GestureRecognizers>
                                                                <Label Grid.Column="0" Text="{Binding .}" TextColor="White" FontSize="14" VerticalOptions="Center" />
                                                                <Button Grid.Column="1" 
                                                                        Text="✕" 
                                                                        TextColor="#FF6B6B" 
                                                                        BackgroundColor="Transparent" 
                                                                        FontSize="12"
                                                                        HeightRequest="30"
                                                                        WidthRequest="30"
                                                                        Padding="0"
                                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RegistroViewModel}}, Path=EliminarPreguntaDisponibleCommand}"
                                                                        CommandParameter="{Binding .}">
                                                                    <Button.Triggers>
                                                                        <DataTrigger TargetType="Button" Binding="{Binding .}" Value="Escribir mi propia pregunta...">
                                                                            <Setter Property="IsVisible" Value="False" />
                                                                        </DataTrigger>
                                                                    </Button.Triggers>
                                                                </Button>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </CollectionView.ItemTemplate>
                                                </CollectionView>
                                            </Border>
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Spacing="5" IsVisible="{Binding IsCustomQuestionVisible}">
                                            <Label Text="Escribe tu pregunta" TextColor="White" FontSize="14" FontAttributes="Bold"/>
                                            <Entry Placeholder="¿Cuál es tu pregunta?"
                                                   TextColor="White"
                                                   PlaceholderColor="#E0E0E0"
                                                   BackgroundColor="Transparent"
                                                   Text="{Binding PreguntaPersonalizada}" />
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Spacing="5">
                                            <Label Text="Respuesta de Seguridad" TextColor="White" FontSize="14" FontAttributes="Bold"/>
                                            <Entry x:Name="RespuestaEntry"
                                                   Placeholder="Tu respuesta"
                                                   TextColor="White"
                                                   PlaceholderColor="#E0E0E0"
                                                   BackgroundColor="Transparent"
                                                   Text="{Binding RespuestaSeguridad}" />
                                        </VerticalStackLayout>

                                        <Button Text="Registrarse"
                                                Margin="0,20,0,0"
                                                BackgroundColor="#5e17eb"
                                                TextColor="White"
                                                CornerRadius="25"
                                                HeightRequest="48"
                                                Command="{Binding RegistrarCommand}" />

                                    </VerticalStackLayout>
                                </Frame>

                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Grid>
            </VerticalStackLayout>
        </Grid>
    </ScrollView>

</ContentPage>

















































































































