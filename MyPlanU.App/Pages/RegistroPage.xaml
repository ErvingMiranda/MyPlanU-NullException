<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyPlanU.App.Pages.RegistroPage"
             Title="Registro"
             Style="{StaticResource BasePageStyle}"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <Grid Padding="30">
            <VerticalStackLayout 
                Spacing="15" 
                VerticalOptions="Center">

                <!-- Contenido centrado encima del fondo -->
                <Grid Padding="30">
                    <VerticalStackLayout
                      Spacing="15"
                      VerticalOptions="Center">

                        <!-- Contenido centrado encima del fondo -->
                        <Grid Padding="30">
                            <!-- Dos filas: logo en la parte superior (auto) y contenido centrado en el resto -->
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Image Source="mylogo.png"
                                   Grid.Row="0"
                                   HeightRequest="200"
                                   WidthRequest="200"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Start"
                                   Margin="0,0,0,10" />

                            <VerticalStackLayout
                                Grid.Row="1"
                                Spacing="15"
                                VerticalOptions="Center">

                                <Grid ColumnDefinitions="Auto, *" VerticalOptions="Center" Margin="0,0,0,10">
                                    <Button Text="❮" 
                                            TextColor="White"
                                            BackgroundColor="#30000000"
                                            CornerRadius="20"
                                            HeightRequest="40"
                                            WidthRequest="40"
                                            Padding="0"
                                            FontSize="20"
                                            Command="{Binding GoBackCommand}" 
                                            HorizontalOptions="Start"
                                            VerticalOptions="Center"
                                            ZIndex="1"/>
                                            
                                    <Label Text="Crear Cuenta"
                                           Grid.Column="0" Grid.ColumnSpan="2"
                                           FontSize="34"
                                           FontAttributes="Bold"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"
                                           TextColor="White" />
                                </Grid>

                                <Frame BackgroundColor="#50000000"
                                       CornerRadius="20"
                                       Padding="20">

                                    <VerticalStackLayout Spacing="15">

                                        <VerticalStackLayout Spacing="5">
                                            <Label Text="Nombre" TextColor="White" FontSize="14" FontAttributes="Bold"/>
                                            <Entry x:Name="NombreEntry"
                                                   Placeholder="Tu nombre"
                                                   TextColor="White"
                                                   PlaceholderColor="#E0E0E0"
                                                   BackgroundColor="Transparent"
                                                   Text="{Binding Nombre}" />
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Spacing="5">
                                            <Label Text="Correo" TextColor="White" FontSize="14" FontAttributes="Bold"/>
                                            <Entry x:Name="EmailEntry"
                                                   Placeholder="tu@correo.com"
                                                   Keyboard="Email"
                                                   TextColor="White"
                                                   PlaceholderColor="#E0E0E0"
                                                   BackgroundColor="Transparent"
                                                   Text="{Binding Email}" />
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Spacing="5">
                                            <Label Text="Contraseña" TextColor="White" FontSize="14" FontAttributes="Bold"/>
                                            <Entry x:Name="PasswordEntry"
                                                   Placeholder="Contraseña"
                                                   IsPassword="True"
                                                   TextColor="White"
                                                   PlaceholderColor="#E0E0E0"
                                                   BackgroundColor="Transparent"
                                                   Text="{Binding Password}" />
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Spacing="5">
                                            <Label Text="Pregunta de Seguridad" TextColor="White" FontSize="14" FontAttributes="Bold"/>
                                            <Picker x:Name="PreguntaPicker"
                                                    Title="Selecciona una pregunta"
                                                    TitleColor="#E0E0E0"
                                                    TextColor="White"
                                                    BackgroundColor="Transparent"
                                                    ItemsSource="{Binding PreguntasDisponibles}"
                                                    SelectedItem="{Binding PreguntaSeguridad}" />
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Spacing="5" IsVisible="{Binding IsCustomQuestionVisible}">
                                            <Label Text="Escribe tu pregunta" TextColor="White" FontSize="14" FontAttributes="Bold"/>
                                            <Entry Placeholder="¿Cuál es tu pregunta?"
                                                   TextColor="White"
                                                   PlaceholderColor="#E0E0E0"
                                                   BackgroundColor="Transparent"
                                                   Text="{Binding PreguntaPersonalizada}" />
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Spacing="5">
                                            <Label Text="Respuesta de Seguridad" TextColor="White" FontSize="14" FontAttributes="Bold"/>
                                            <Entry x:Name="RespuestaEntry"
                                                   Placeholder="Tu respuesta"
                                                   TextColor="White"
                                                   PlaceholderColor="#E0E0E0"
                                                   BackgroundColor="Transparent"
                                                   Text="{Binding RespuestaSeguridad}" />
                                        </VerticalStackLayout>

                                        <Button Text="Registrarse"
                                                Margin="0,20,0,0"
                                                BackgroundColor="#5e17eb"
                                                TextColor="White"
                                                CornerRadius="25"
                                                HeightRequest="48"
                                                Command="{Binding RegistrarCommand}" />

                                    </VerticalStackLayout>
                                </Frame>

                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Grid>
            </VerticalStackLayout>
        </Grid>
    </ScrollView>

</ContentPage>








