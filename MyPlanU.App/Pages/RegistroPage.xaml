<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MyPlanU.App.Pages.RegistroPage"
             Title="Registro"
             Style="{StaticResource BasePageStyle}">

    <ScrollView>
        <Grid Padding="30">
            <VerticalStackLayout 
                Spacing="15" 
                VerticalOptions="Center">

                <!-- Contenido centrado encima del fondo -->
                <Grid Padding="30">
                    <VerticalStackLayout
                      Spacing="15"
                      VerticalOptions="Center">

                        <!-- Contenido centrado encima del fondo -->
                        <Grid Padding="30">
                            <!-- Dos filas: logo en la parte superior (auto) y contenido centrado en el resto -->
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Image Source="mylogo.png"
                                   Grid.Row="0"
                                   HeightRequest="120"
                                   WidthRequest="120"
                                   HorizontalOptions="End"
                                   VerticalOptions="Start"
                                   Margin="0,0,0,10" />

                            <VerticalStackLayout
                                Grid.Row="1"
                                Spacing="15"
                                VerticalOptions="Center">

                                <Label Text="Crear Cuenta"
                                       FontSize="34"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       TextColor="White" />

                                <Frame BackgroundColor="#50000000"
                                       CornerRadius="20"
                                       Padding="20">

                                    <VerticalStackLayout Spacing="15">

                                        <VerticalStackLayout Spacing="5">
                                            <Label Text="Nombre" TextColor="White" FontSize="14" FontAttributes="Bold"/>
                                            <Entry x:Name="NombreEntry"
                                                   Placeholder="Tu nombre"
                                                   TextColor="White"
                                                   PlaceholderColor="#E0E0E0"
                                                   BackgroundColor="Transparent" />
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Spacing="5">
                                            <Label Text="Correo" TextColor="White" FontSize="14" FontAttributes="Bold"/>
                                            <Entry x:Name="EmailEntry"
                                                   Placeholder="tu@correo.com"
                                                   Keyboard="Email"
                                                   TextColor="White"
                                                   PlaceholderColor="#E0E0E0"
                                                   BackgroundColor="Transparent" />
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Spacing="5">
                                            <Label Text="Contraseña" TextColor="White" FontSize="14" FontAttributes="Bold"/>
                                            <Entry x:Name="PasswordEntry"
                                                   Placeholder="Contraseña"
                                                   IsPassword="True"
                                                   TextColor="White"
                                                   PlaceholderColor="#E0E0E0"
                                                   BackgroundColor="Transparent" />
                                        </VerticalStackLayout>

                                        <Button Text="Registrarse"
                                                Margin="0,20,0,0"
                                                BackgroundColor="#5e17eb"
                                                TextColor="White"
                                                CornerRadius="25"
                                                HeightRequest="48"
                                                Clicked="OnRegistrarseClicked" />

                                    </VerticalStackLayout>
                                </Frame>

                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Grid>
            </VerticalStackLayout>
        </Grid>
    </ScrollView>

</ContentPage>








