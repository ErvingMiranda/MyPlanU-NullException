<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MyPlanU.App.ViewModels"
             x:Class="MyPlanU.App.Pages.CrearEventoPage"
             Title="Crear Evento">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Label Text="Nuevo Evento" Style="{StaticResource Headline}" HorizontalOptions="Center" />

            <Entry Placeholder="Título" Text="{Binding Titulo}" />
            
            <Label Text="Etiqueta" FontAttributes="Bold" />
            <Picker Title="Selecciona una etiqueta"
                    ItemsSource="{Binding EtiquetasDisponibles}"
                    SelectedItem="{Binding EtiquetaSeleccionadaPicker}" />

            <HorizontalStackLayout IsVisible="{Binding IsNuevaEtiquetaVisible}" Spacing="10">
                <Entry Placeholder="Nueva etiqueta" Text="{Binding NuevaEtiquetaTexto}" HorizontalOptions="FillAndExpand" />
                <Button Text="Agregar" Command="{Binding AgregarNuevaEtiquetaCommand}" />
            </HorizontalStackLayout>

            <Editor Placeholder="Descripción" Text="{Binding Descripcion}" AutoSize="TextChanges" />

            <Label Text="Inicio" FontAttributes="Bold" />
            <DatePicker Date="{Binding FechaInicio}" />
            <TimePicker Time="{Binding HoraInicio}" />

            <Label Text="Fin" FontAttributes="Bold" />
            <DatePicker Date="{Binding FechaFin}" />
            <TimePicker Time="{Binding HoraFin}" />

            <Button Text="Guardar" Command="{Binding GuardarCommand}" Margin="0,20,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
