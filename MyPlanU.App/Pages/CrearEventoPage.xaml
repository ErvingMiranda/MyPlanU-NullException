<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MyPlanU.App.ViewModels"
             x:Class="MyPlanU.App.Pages.CrearEventoPage"
             Title="{Binding PageTitle}"
             Style="{StaticResource BasePageStyle}">

    <ScrollView>
        <Grid Padding="20">
            <VerticalStackLayout Spacing="15">
                <Label Text="{Binding HeaderTitle}" 
                       FontSize="28" 
                       FontAttributes="Bold" 
                       HorizontalOptions="Center" 
                       TextColor="White" />

                <Frame BackgroundColor="#50000000"
                       CornerRadius="20"
                       Padding="20">
                    <VerticalStackLayout Spacing="15">

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Título" TextColor="White" FontSize="14" FontAttributes="Bold"/>
                            <Entry Placeholder="Título del evento" 
                                   Text="{Binding Titulo}"
                                   TextColor="White"
                                   PlaceholderColor="#E0E0E0"
                                   BackgroundColor="Transparent" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Etiquetas" TextColor="White" FontSize="14" FontAttributes="Bold" />
                            <Picker Title="Selecciona una etiqueta"
                                    ItemsSource="{Binding EtiquetasDisponibles}"
                                    SelectedItem="{Binding EtiquetaSeleccionadaPicker}"
                                    TextColor="White"
                                    TitleColor="#E0E0E0"
                                    BackgroundColor="Transparent" />
                        </VerticalStackLayout>

                        <HorizontalStackLayout IsVisible="{Binding IsNuevaEtiquetaVisible}" Spacing="10">
                            <Entry Placeholder="Nueva etiqueta" 
                                   Text="{Binding NuevaEtiquetaTexto}" 
                                   HorizontalOptions="FillAndExpand"
                                   TextColor="White"
                                   PlaceholderColor="#E0E0E0"
                                   BackgroundColor="Transparent" />
                            <Button Text="Agregar" 
                                    Command="{Binding AgregarNuevaEtiquetaCommand}"
                                    BackgroundColor="#2fffa3"
                                    TextColor="#5e17eb"
                                    CornerRadius="15"
                                    HeightRequest="40"/>
                        </HorizontalStackLayout>

                        <!-- Selected Tags List -->
                        <CollectionView ItemsSource="{Binding EtiquetasSeleccionadas}" HeightRequest="60">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="5" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Frame Padding="10,5" BackgroundColor="#30FFFFFF" CornerRadius="15" BorderColor="Transparent">
                                        <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                            <Label Text="{Binding .}" VerticalOptions="Center" TextColor="White" />
                                            <Button Text="✕" 
                                                    FontSize="12" 
                                                    HeightRequest="25" 
                                                    WidthRequest="25" 
                                                    Padding="0"
                                                    BackgroundColor="Transparent" 
                                                    TextColor="#FF6B6B"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CrearEventoViewModel}}, Path=EliminarEtiquetaCommand}"
                                                    CommandParameter="{Binding .}" />
                                        </HorizontalStackLayout>
                                    </Frame>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Descripción" TextColor="White" FontSize="14" FontAttributes="Bold"/>
                            <Editor Placeholder="Detalles del evento" 
                                    Text="{Binding Descripcion}" 
                                    AutoSize="TextChanges"
                                    TextColor="White"
                                    PlaceholderColor="#E0E0E0"
                                    BackgroundColor="Transparent" />
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0" Spacing="5">
                                <Label Text="Inicio" TextColor="White" FontAttributes="Bold" />
                                <DatePicker Date="{Binding FechaInicio}" TextColor="White" BackgroundColor="Transparent" />
                                <TimePicker Time="{Binding HoraInicio}" TextColor="White" BackgroundColor="Transparent" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" Spacing="5">
                                <Label Text="Fin" TextColor="White" FontAttributes="Bold" />
                                <DatePicker Date="{Binding FechaFin}" TextColor="White" BackgroundColor="Transparent" />
                                <TimePicker Time="{Binding HoraFin}" TextColor="White" BackgroundColor="Transparent" />
                            </VerticalStackLayout>
                        </Grid>

                        <Button Text="Guardar" 
                                Command="{Binding GuardarCommand}" 
                                Margin="0,20,0,0"
                                BackgroundColor="#5e17eb"
                                TextColor="White"
                                CornerRadius="25"
                                HeightRequest="48" />
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
