<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MyPlanU.App.ViewModels"
             x:Class="MyPlanU.App.Pages.CrearEventoPage"
             Title="{Binding PageTitle}"
             Style="{StaticResource BasePageStyle}"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <Grid Padding="20">
            <VerticalStackLayout Spacing="15">
                <Grid ColumnDefinitions="Auto, *" VerticalOptions="Center" Margin="0,0,0,10">
                    <Button Text="❮" 
                            TextColor="White"
                            BackgroundColor="#30000000"
                            CornerRadius="20"
                            HeightRequest="40"
                            WidthRequest="40"
                            Padding="0"
                            FontSize="20"
                            Command="{Binding GoBackCommand}" 
                            HorizontalOptions="Start"
                            VerticalOptions="Center"
                            ZIndex="1"/>
                            
                    <Label Text="{Binding HeaderTitle}" 
                           Grid.Column="0" Grid.ColumnSpan="2"
                           FontSize="28" 
                           FontAttributes="Bold" 
                           HorizontalOptions="Center" 
                           VerticalOptions="Center"
                           TextColor="White" />
                </Grid>

                <Frame BackgroundColor="#50000000"
                       CornerRadius="20"
                       Padding="20">
                    <VerticalStackLayout Spacing="15">

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Título" TextColor="White" FontSize="14" FontAttributes="Bold"/>
                            <Entry Placeholder="Título del evento" 
                                   Text="{Binding Titulo}"
                                   TextColor="White"
                                   PlaceholderColor="#E0E0E0"
                                   BackgroundColor="Transparent" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Etiquetas" TextColor="White" FontSize="14" FontAttributes="Bold" />
                            <Border Stroke="#2fffa3" 
                                    StrokeThickness="1" 
                                    StrokeShape="RoundRectangle 10" 
                                    BackgroundColor="#20FFFFFF" 
                                    HeightRequest="50"
                                    Padding="0">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleTagsDropdownCommand}" />
                                </Border.GestureRecognizers>
                                <Border.Shadow>
                                    <Shadow Brush="Black" Offset="2,2" Opacity="0.2" Radius="5"/>
                                </Border.Shadow>
                                <Grid ColumnDefinitions="*, 50">
                                    <Label Grid.Column="0" 
                                           Text="Selecciona una etiqueta"
                                           VerticalOptions="Center" 
                                           Margin="15,0"
                                           TextColor="#E0E0E0"
                                           LineBreakMode="TailTruncation">
                                    </Label>

                                    <Grid Grid.Column="1" BackgroundColor="Black">
                                        <Label Text="▼" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" FontSize="12"/>
                                    </Grid>
                                </Grid>
                            </Border>
                            
                            <!-- Custom Dropdown List -->
                            <Border IsVisible="{Binding IsTagsDropdownVisible}"
                                    Stroke="#2fffa3"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 10"
                                    BackgroundColor="#202020"
                                    MaximumHeightRequest="200"
                                    Padding="0"
                                    Margin="0,-5,0,0"
                                    ZIndex="100">
                                <CollectionView ItemsSource="{Binding EtiquetasDisponibles}"
                                                VerticalScrollBarVisibility="Always">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Padding="15,10" BackgroundColor="Transparent" ColumnDefinitions="*, Auto">
                                                <Grid.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CrearEventoViewModel}}, Path=SelectTagCommand}"
                                                                          CommandParameter="{Binding .}" />
                                                </Grid.GestureRecognizers>
                                                <Label Grid.Column="0" Text="{Binding .}" TextColor="White" FontSize="14" VerticalOptions="Center" />
                                                <Button Grid.Column="1" 
                                                        Text="✕" 
                                                        TextColor="#FF6B6B" 
                                                        BackgroundColor="Transparent" 
                                                        FontSize="12"
                                                        HeightRequest="30"
                                                        WidthRequest="30"
                                                        Padding="0"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CrearEventoViewModel}}, Path=EliminarEtiquetaDisponibleCommand}"
                                                        CommandParameter="{Binding .}">
                                                    <Button.Triggers>
                                                        <DataTrigger TargetType="Button" Binding="{Binding .}" Value="Crear nueva...">
                                                            <Setter Property="IsVisible" Value="False" />
                                                        </DataTrigger>
                                                    </Button.Triggers>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </Border>
                        </VerticalStackLayout>

                        <HorizontalStackLayout IsVisible="{Binding IsNuevaEtiquetaVisible}" Spacing="10">
                            <Entry Placeholder="Nueva etiqueta" 
                                   Text="{Binding NuevaEtiquetaTexto}" 
                                   HorizontalOptions="FillAndExpand"
                                   TextColor="White"
                                   PlaceholderColor="#E0E0E0"
                                   BackgroundColor="Transparent" />
                            <Button Text="Agregar" 
                                    Command="{Binding AgregarNuevaEtiquetaCommand}"
                                    BackgroundColor="#2fffa3"
                                    TextColor="#5e17eb"
                                    CornerRadius="15"
                                    HeightRequest="40"/>
                        </HorizontalStackLayout>

                        <!-- Selected Tags List -->
                        <FlexLayout BindableLayout.ItemsSource="{Binding EtiquetasSeleccionadas}"
                                    Wrap="Wrap"
                                    JustifyContent="Start"
                                    Direction="Row"
                                    AlignItems="Start">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Frame Padding="10,5" Margin="0,0,5,5" BackgroundColor="#30FFFFFF" CornerRadius="15" BorderColor="Transparent" HasShadow="False">
                                        <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                            <Label Text="{Binding .}" VerticalOptions="Center" TextColor="White" />
                                            <Button Text="✕" 
                                                    FontSize="12" 
                                                    HeightRequest="25" 
                                                    WidthRequest="25" 
                                                    Padding="0"
                                                    BackgroundColor="Transparent" 
                                                    TextColor="#FF6B6B"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CrearEventoViewModel}}, Path=EliminarEtiquetaCommand}"
                                                    CommandParameter="{Binding .}" />
                                        </HorizontalStackLayout>
                                    </Frame>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Descripción" TextColor="White" FontSize="14" FontAttributes="Bold"/>
                            <Editor Placeholder="Detalles del evento" 
                                    Text="{Binding Descripcion}" 
                                    AutoSize="TextChanges"
                                    TextColor="White"
                                    PlaceholderColor="#E0E0E0"
                                    BackgroundColor="Transparent" />
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0" Spacing="5">
                                <Label Text="Inicio" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" />
                                <Border StrokeThickness="0" BackgroundColor="#20FFFFFF" StrokeShape="RoundRectangle 10" Padding="10,0" HeightRequest="45">
                                    <DatePicker Date="{Binding FechaInicio}" TextColor="White" BackgroundColor="Transparent" VerticalOptions="Center" HorizontalOptions="Center" />
                                </Border>
                                <Border StrokeThickness="0" BackgroundColor="#20FFFFFF" StrokeShape="RoundRectangle 10" Padding="10,0" HeightRequest="45">
                                    <TimePicker Time="{Binding HoraInicio}" TextColor="White" BackgroundColor="Transparent" VerticalOptions="Center" HorizontalOptions="Center" />
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" Spacing="5">
                                <Label Text="Fin" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center" />
                                <Border StrokeThickness="0" BackgroundColor="#20FFFFFF" StrokeShape="RoundRectangle 10" Padding="10,0" HeightRequest="45">
                                    <DatePicker Date="{Binding FechaFin}" TextColor="White" BackgroundColor="Transparent" VerticalOptions="Center" HorizontalOptions="Center" />
                                </Border>
                                <Border StrokeThickness="0" BackgroundColor="#20FFFFFF" StrokeShape="RoundRectangle 10" Padding="10,0" HeightRequest="45">
                                    <TimePicker Time="{Binding HoraFin}" TextColor="White" BackgroundColor="Transparent" VerticalOptions="Center" HorizontalOptions="Center" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                        <Button Text="Guardar" 
                                Command="{Binding GuardarCommand}" 
                                Margin="0,20,0,0"
                                BackgroundColor="#5e17eb"
                                TextColor="White"
                                CornerRadius="25"
                                HeightRequest="48" />
                    </VerticalStackLayout>
                </Frame>
            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
