<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MyPlanU.App.ViewModels"
             x:Class="MyPlanU.App.Pages.CrearEventoPage"
             Title="Crear Evento">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Label Text="Nuevo Evento" Style="{StaticResource Headline}" HorizontalOptions="Center" />

            <Entry Placeholder="Título" Text="{Binding Titulo}" />
            
            <Label Text="Etiquetas" FontAttributes="Bold" />
            <Picker Title="Selecciona una etiqueta"
                    ItemsSource="{Binding EtiquetasDisponibles}"
                    SelectedItem="{Binding EtiquetaSeleccionadaPicker}" />

            <HorizontalStackLayout IsVisible="{Binding IsNuevaEtiquetaVisible}" Spacing="10">
                <Entry Placeholder="Nueva etiqueta" Text="{Binding NuevaEtiquetaTexto}" HorizontalOptions="FillAndExpand" />
                <Button Text="Agregar" Command="{Binding AgregarNuevaEtiquetaCommand}" />
            </HorizontalStackLayout>

            <!-- Selected Tags List -->
            <CollectionView ItemsSource="{Binding EtiquetasSeleccionadas}" HeightRequest="100">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="5" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Padding="5,2" BackgroundColor="#E0E0E0" CornerRadius="5" BorderColor="Gray">
                            <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                <Label Text="{Binding .}" VerticalOptions="Center" TextColor="Black" />
                                <Button Text="X" 
                                        FontSize="10" 
                                        HeightRequest="20" 
                                        WidthRequest="20" 
                                        Padding="0"
                                        BackgroundColor="Transparent" 
                                        TextColor="Red"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CrearEventoViewModel}}, Path=EliminarEtiquetaCommand}"
                                        CommandParameter="{Binding .}" />
                            </HorizontalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Editor Placeholder="Descripción" Text="{Binding Descripcion}" AutoSize="TextChanges" />

            <Label Text="Inicio" FontAttributes="Bold" />
            <DatePicker Date="{Binding FechaInicio}" />
            <TimePicker Time="{Binding HoraInicio}" />

            <Label Text="Fin" FontAttributes="Bold" />
            <DatePicker Date="{Binding FechaFin}" />
            <TimePicker Time="{Binding HoraFin}" />

            <Button Text="Guardar" Command="{Binding GuardarCommand}" Margin="0,20,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
