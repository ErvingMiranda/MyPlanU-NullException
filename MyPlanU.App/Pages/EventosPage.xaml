<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MyPlanU.App.ViewModels"
             xmlns:models="clr-namespace:MyPlanU.Backend.Models;assembly=MyPlanU.Backend"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="MyPlanU.App.Pages.EventosPage"
             Title="Eventos"
             Style="{StaticResource BasePageStyle}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <toolkit:IsStringNotNullOrEmptyConverter x:Key="IsNotNullOrEmptyConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, *">
        <!-- Header / Toolbar -->
        <Grid Grid.Row="0" Padding="15" ColumnDefinitions="*, Auto">
            <Label Text="Mis Eventos" 
                   FontSize="28" 
                   FontAttributes="Bold" 
                   TextColor="White" 
                   VerticalOptions="Center"/>
            
            <HorizontalStackLayout Grid.Column="1" Spacing="10">
                <Button Text="Prompty" Command="{Binding OpenPromptyCommand}" BackgroundColor="#50FFFFFF" TextColor="White" CornerRadius="15" HeightRequest="35" Padding="10,0"/>
                <Button Text="Config" Command="{Binding GoToConfigCommand}" BackgroundColor="#50FFFFFF" TextColor="White" CornerRadius="15" HeightRequest="35" Padding="10,0"/>
                <Button Text="Logout" Command="{Binding LogoutCommand}" BackgroundColor="#50FFFFFF" TextColor="White" CornerRadius="15" HeightRequest="35" Padding="10,0"/>
                <Button Text="✕" Command="{Binding ExitAppCommand}" BackgroundColor="#FF6B6B" TextColor="White" CornerRadius="15" HeightRequest="35" WidthRequest="35" Padding="0"/>
            </HorizontalStackLayout>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20" Spacing="20">

                <CollectionView ItemsSource="{Binding Actividades}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Actividad">
                            <Frame Padding="15" Margin="0,0,0,15"
                                   BackgroundColor="#50000000"
                                   BorderColor="Transparent"
                                   CornerRadius="20">
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <Label Grid.Column="0" Text="{Binding Titulo}" FontSize="20" FontAttributes="Bold" TextColor="White" LineBreakMode="TailTruncation"/>
                                        <Label Grid.Column="1" Text="{Binding Etiquetas}" FontSize="12" FontAttributes="Italic" TextColor="#2fffa3" IsVisible="{Binding Etiquetas, Converter={StaticResource IsNotNullOrEmptyConverter}}" VerticalOptions="Center"/>
                                    </Grid>
                                    
                                    <Label Text="{Binding Descripcion}" FontSize="14" TextColor="#E0E0E0" MaxLines="2" LineBreakMode="TailTruncation"/>
                                    
                                    <HorizontalStackLayout Spacing="15">
                                        <Label Text="{Binding FechaInicio, StringFormat='{0:MMM dd, HH:mm}'}" FontSize="12" TextColor="#CCCCCC" />
                                        <Label Text="-" FontSize="12" TextColor="#CCCCCC" />
                                        <Label Text="{Binding FechaFin, StringFormat='{0:MMM dd, HH:mm}'}" FontSize="12" TextColor="#CCCCCC" />
                                    </HorizontalStackLayout>

                                    <BoxView HeightRequest="1" Color="#30FFFFFF" Margin="0,5"/>

                                    <HorizontalStackLayout Spacing="10" HorizontalOptions="End">
                                        <Button Text="Editar"
                                                BackgroundColor="#50FFFFFF"
                                                TextColor="White"
                                                CornerRadius="15"
                                                HeightRequest="35"
                                                Padding="15,0"
                                                FontSize="12"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:EventosViewModel}}, Path=EditarEventoCommand}"
                                                CommandParameter="{Binding .}" />
                                        <Button Text="Eliminar"
                                                BackgroundColor="#FF6B6B"
                                                TextColor="White"
                                                CornerRadius="15"
                                                HeightRequest="35"
                                                Padding="15,0"
                                                FontSize="12"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:EventosViewModel}}, Path=EliminarEventoCommand}"
                                                CommandParameter="{Binding .}" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Button Text="+ Agregar Evento"
                        Command="{Binding AgregarEventoCommand}"
                        BackgroundColor="#2fffa3"
                        TextColor="#5e17eb"
                        FontAttributes="Bold"
                        CornerRadius="25"
                        HorizontalOptions="Fill"
                        HeightRequest="50" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
