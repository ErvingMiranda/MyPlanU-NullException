<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MyPlanU.App.ViewModels"
             x:Class="MyPlanU.App.Pages.RecuperarPasswordPage"
             Title="Recuperar Contraseña"
             Style="{StaticResource BasePageStyle}"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <Grid Padding="30">
            <VerticalStackLayout Spacing="20" VerticalOptions="Center">

                <Grid ColumnDefinitions="Auto, *" VerticalOptions="Center" Margin="0,0,0,10">
                    <Button Text="❮" 
                            TextColor="White"
                            BackgroundColor="#30000000"
                            CornerRadius="20"
                            HeightRequest="40"
                            WidthRequest="40"
                            Padding="0"
                            FontSize="20"
                            Command="{Binding GoBackCommand}" 
                            HorizontalOptions="Start"
                            VerticalOptions="Center"
                            ZIndex="1"/>
                            
                    <Label Text="Recuperar Contraseña"
                           Grid.Column="0" Grid.ColumnSpan="2"
                           FontSize="28" 
                           FontAttributes="Bold" 
                           HorizontalOptions="Center" 
                           VerticalOptions="Center"
                           TextColor="White" />
                </Grid>

                <Frame BackgroundColor="#50000000"
                       CornerRadius="20"
                       Padding="20">

                    <VerticalStackLayout Spacing="15">

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Correo" TextColor="White" FontSize="14" FontAttributes="Bold"/>
                            <Entry Placeholder="Ingresa tu correo"
                                   Text="{Binding Email}"
                                   TextColor="White"
                                   PlaceholderColor="#E0E0E0"
                                   BackgroundColor="Transparent" />
                            <Button Text="Buscar"
                                    Command="{Binding FindUserCommand}"
                                    BackgroundColor="#5e17eb"
                                    TextColor="White"
                                    CornerRadius="25"
                                    HeightRequest="40"
                                    Margin="0,10,0,0" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="5" IsVisible="{Binding IsQuestionVisible}">
                            <Label Text="{Binding SecurityQuestion}" TextColor="White" FontSize="14" FontAttributes="Bold"/>
                            <Entry Placeholder="Tu respuesta"
                                   Text="{Binding SecurityAnswer}"
                                   TextColor="White"
                                   PlaceholderColor="#E0E0E0"
                                   BackgroundColor="Transparent" />
                            <Button Text="Verificar"
                                    Command="{Binding VerifyAnswerCommand}"
                                    BackgroundColor="#5e17eb"
                                    TextColor="White"
                                    CornerRadius="25"
                                    HeightRequest="40"
                                    Margin="0,10,0,0" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="5" IsVisible="{Binding IsPasswordVisible}">
                            <Label Text="Nueva Contraseña" TextColor="White" FontSize="14" FontAttributes="Bold"/>
                            <Entry Placeholder="Nueva contraseña"
                                   IsPassword="True"
                                   Text="{Binding NewPassword}"
                                   TextColor="White"
                                   PlaceholderColor="#E0E0E0"
                                   BackgroundColor="Transparent" />
                            <Button Text="Restablecer"
                                    Command="{Binding ResetPasswordCommand}"
                                    BackgroundColor="#5e17eb"
                                    TextColor="White"
                                    CornerRadius="25"
                                    HeightRequest="40"
                                    Margin="0,10,0,0" />
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
