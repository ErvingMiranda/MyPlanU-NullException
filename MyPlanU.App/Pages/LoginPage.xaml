<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MyPlanU.App.ViewModels"
             x:Class="MyPlanU.App.Pages.LoginPage"
             Title="Login"
             Style="{StaticResource BasePageStyle}">

    <!-- Contenido centrado encima del fondo -->
    <Grid Padding="30">
        <VerticalStackLayout
            Spacing="15"
            VerticalOptions="Center">

            <!-- Contenido centrado encima del fondo -->
            <Grid Padding="30">
                <!-- Dos filas: logo en la parte superior (auto) y contenido centrado en el resto -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Dos columnas en la fila superior para situar la imagen a la derecha -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image Source="mylogo.png"
                       Grid.Row="0"
                       Grid.Column="1"
                       HeightRequest="120"
                       WidthRequest="120"
                       HorizontalOptions="Center"
                       VerticalOptions="Start"
                       Margin="0,0,0,10" />

                <VerticalStackLayout
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    Spacing="15"
                    VerticalOptions="Center">


                    <Label Text="Iniciar Sesión"
                           FontSize="34"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           TextColor="White" />

                    <Frame BackgroundColor="#50000000"
                           CornerRadius="20"
                           Padding="20">

                        <VerticalStackLayout Spacing="10">

                            <Entry x:Name="EmailEntry" Placeholder="Correo"
                                   TextColor="White"
                                   PlaceholderColor="#E0E0E0"
                                   BackgroundColor="Transparent" />

                            <Entry x:Name="PasswordEntry" Placeholder="Contraseña"
                                   IsPassword="True"
                                   TextColor="White"
                                   PlaceholderColor="#E0E0E0"
                                   BackgroundColor="Transparent" />

                            <Button Text="Ingresar"
                                    Margin="0,20,0,0"
                                    BackgroundColor="#5e17eb"
                                    TextColor="White"
                                    CornerRadius="25"
                                    HeightRequest="48" 
                                    Clicked="OnLoginClicked" />

                            <Button Text="¿No tienes cuenta? Regístrate"
                                    Clicked="OnRegisterClicked"
                                    BackgroundColor="Transparent"
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    Margin="0,10,0,0" />


                        </VerticalStackLayout>
                    </Frame>

                </VerticalStackLayout>

            </Grid>

        </VerticalStackLayout>
    </Grid>
</ContentPage>