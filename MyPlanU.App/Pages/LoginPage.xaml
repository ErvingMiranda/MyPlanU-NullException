<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MyPlanU.App.ViewModels"
             x:Class="MyPlanU.App.Pages.LoginPage"
             Title="Login"
             Style="{StaticResource BasePageStyle}">

    <!-- Contenido centrado encima del fondo -->
    <Grid Padding="30">
        <!-- Botón de Salir en la esquina superior derecha -->
        <Button Text="✕"
                Command="{Binding ExitCommand}"
                BackgroundColor="#FF6B6B"
                TextColor="White"
                CornerRadius="15"
                FontSize="18"
                FontAttributes="Bold"
                HorizontalOptions="End"
                VerticalOptions="Start"
                HeightRequest="35"
                WidthRequest="35"
                Margin="0,0,0,0"
                ZIndex="1" />

        <VerticalStackLayout
            Spacing="15"
            VerticalOptions="Center">

            <!-- Contenido centrado encima del fondo -->
            <Grid Padding="30">
                <!-- Dos filas: logo en la parte superior (auto) y contenido centrado en el resto -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Image Source="{AppThemeBinding Light=mylogo.png, Dark=mylogoWhite.jpg}"
                       Grid.Row="0"
                       HeightRequest="200"
                       WidthRequest="200"
                       HorizontalOptions="Center"
                       VerticalOptions="Start"
                       Margin="0,0,0,10" />

                <VerticalStackLayout
                    Grid.Row="1"
                    Spacing="15"
                    VerticalOptions="Center">


                    <Label Text="Iniciar Sesión"
                           FontSize="34"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           TextColor="White" />

                    <Frame BackgroundColor="#50000000"
                           CornerRadius="20"
                           Padding="20">

                        <VerticalStackLayout Spacing="10">

                            <Entry x:Name="EmailEntry" Placeholder="Correo"
                                   Text="{Binding Email}"
                                   TextColor="White"
                                   PlaceholderColor="#E0E0E0"
                                   BackgroundColor="Transparent" />

                            <Entry x:Name="PasswordEntry" Placeholder="Contraseña"
                                   IsPassword="True"
                                   Text="{Binding Password}"
                                   TextColor="White"
                                   PlaceholderColor="#E0E0E0"
                                   BackgroundColor="Transparent" />

                            <Button Text="Ingresar"
                                    Margin="0,20,0,0"
                                    BackgroundColor="#5e17eb"
                                    TextColor="White"
                                    CornerRadius="25"
                                    HeightRequest="48" 
                                    Command="{Binding LoginCommand}" />

                            <Button Text="Olvidé mi contraseña"
                                    Command="{Binding ForgotPasswordCommand}"
                                    BackgroundColor="Transparent"
                                    TextColor="#E0E0E0"
                                    FontSize="12"
                                    Margin="0,5,0,0" />

                            <Button Text="¿No tienes cuenta? Regístrate"
                                    Command="{Binding GoToRegistroCommand}"
                                    BackgroundColor="Transparent"
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    Margin="0,10,0,0" />


                        </VerticalStackLayout>
                    </Frame>

                </VerticalStackLayout>

            </Grid>

        </VerticalStackLayout>
    </Grid>
</ContentPage>