<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MyPlanU.App.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="MyPlanU.App.Pages.CambiarPasswordPage"
             Title="Cambiar Contraseña"
             Style="{StaticResource BasePageStyle}"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <Grid Padding="30">
            <VerticalStackLayout Spacing="20" VerticalOptions="Center">

                <Grid ColumnDefinitions="Auto, *" VerticalOptions="Center" Margin="0,0,0,10">
                    <Button Text="❮" 
                            TextColor="White"
                            BackgroundColor="#30000000"
                            CornerRadius="20"
                            HeightRequest="40"
                            WidthRequest="40"
                            Padding="0"
                            FontSize="20"
                            Command="{Binding GoBackCommand}" 
                            HorizontalOptions="Start"
                            VerticalOptions="Center"
                            ZIndex="1"/>
                            
                    <Label Text="Cambiar Contraseña"
                           Grid.Column="0" Grid.ColumnSpan="2"
                           FontSize="28" 
                           FontAttributes="Bold" 
                           HorizontalOptions="Center" 
                           VerticalOptions="Center"
                           TextColor="White" />
                </Grid>

                <Frame BackgroundColor="#50000000"
                       CornerRadius="20"
                       Padding="20">

                    <VerticalStackLayout Spacing="15">

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Contraseña Actual" TextColor="White" FontSize="14" FontAttributes="Bold"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <Entry Grid.Column="0"
                                       Placeholder="Ingresa tu contraseña actual"
                                       IsPassword="{Binding IsCurrentPasswordHidden}"
                                       Text="{Binding CurrentPassword}"
                                       TextColor="White"
                                       PlaceholderColor="#E0E0E0"
                                       BackgroundColor="Transparent" />
                                <Button Grid.Column="1"
                                        Text="Ver"
                                        Command="{Binding ToggleCurrentPasswordVisibilityCommand}"
                                        BackgroundColor="#5e17eb"
                                        TextColor="White"
                                        CornerRadius="8"
                                        HeightRequest="36"
                                        WidthRequest="60"
                                        Padding="0"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        VerticalOptions="Center"
                                        Margin="8,0,0,0">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Binding="{Binding IsCurrentPasswordHidden}" Value="False">
                                            <Setter Property="Text" Value="Ocultar" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                            </Grid>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Nueva Contraseña" TextColor="White" FontSize="14" FontAttributes="Bold"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <Entry Grid.Column="0"
                                       Placeholder="Ingresa la nueva contraseña"
                                       IsPassword="{Binding IsNewPasswordHidden}"
                                       Text="{Binding NewPassword}"
                                       TextColor="White"
                                       PlaceholderColor="#E0E0E0"
                                       BackgroundColor="Transparent" />
                                <Button Grid.Column="1"
                                        Text="Ver"
                                        Command="{Binding ToggleNewPasswordVisibilityCommand}"
                                        BackgroundColor="#5e17eb"
                                        TextColor="White"
                                        CornerRadius="8"
                                        HeightRequest="36"
                                        WidthRequest="60"
                                        Padding="0"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        VerticalOptions="Center"
                                        Margin="8,0,0,0">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Binding="{Binding IsNewPasswordHidden}" Value="False">
                                            <Setter Property="Text" Value="Ocultar" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                            </Grid>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Confirmar Contraseña" TextColor="White" FontSize="14" FontAttributes="Bold"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <Entry Grid.Column="0"
                                       Placeholder="Repite la nueva contraseña"
                                       IsPassword="{Binding IsConfirmPasswordHidden}"
                                       Text="{Binding ConfirmPassword}"
                                       TextColor="White"
                                       PlaceholderColor="#E0E0E0"
                                       BackgroundColor="Transparent" />
                                <Button Grid.Column="1"
                                        Text="Ver"
                                        Command="{Binding ToggleConfirmPasswordVisibilityCommand}"
                                        BackgroundColor="#5e17eb"
                                        TextColor="White"
                                        CornerRadius="8"
                                        HeightRequest="36"
                                        WidthRequest="60"
                                        Padding="0"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        VerticalOptions="Center"
                                        Margin="8,0,0,0">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Binding="{Binding IsConfirmPasswordHidden}" Value="False">
                                            <Setter Property="Text" Value="Ocultar" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                            </Grid>
                        </VerticalStackLayout>

                        <Button Text="Actualizar"
                                Command="{Binding CambiarCommand}"
                                Margin="0,20,0,0"
                                BackgroundColor="#5e17eb"
                                TextColor="White"
                                CornerRadius="25"
                                HeightRequest="48" />

                    </VerticalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
