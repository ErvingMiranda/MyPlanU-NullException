<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MyPlanU.App.ViewModels"
             x:Class="MyPlanU.App.Pages.CambiarPasswordPage"
             Title="Cambiar Contraseña">

    <!-- Fondo degradado consistente -->
    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#5e17eb" Offset="0.0" />
            <GradientStop Color="#2fffa3" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <ScrollView>
        <Grid Padding="30">
            <VerticalStackLayout Spacing="20" VerticalOptions="Center">

                <Label Text="Cambiar Contraseña"
                       FontSize="28"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="White" />

                <Frame BackgroundColor="#50000000"
                       CornerRadius="20"
                       Padding="20">

                    <VerticalStackLayout Spacing="15">

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Contraseña Actual" TextColor="White" FontSize="14" FontAttributes="Bold"/>
                            <Entry Placeholder="Ingresa tu contraseña actual"
                                   IsPassword="True"
                                   Text="{Binding CurrentPassword}"
                                   TextColor="White"
                                   PlaceholderColor="#E0E0E0"
                                   BackgroundColor="Transparent" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Nueva Contraseña" TextColor="White" FontSize="14" FontAttributes="Bold"/>
                            <Entry Placeholder="Ingresa la nueva contraseña"
                                   IsPassword="True"
                                   Text="{Binding NewPassword}"
                                   TextColor="White"
                                   PlaceholderColor="#E0E0E0"
                                   BackgroundColor="Transparent" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="5">
                            <Label Text="Confirmar Contraseña" TextColor="White" FontSize="14" FontAttributes="Bold"/>
                            <Entry Placeholder="Repite la nueva contraseña"
                                   IsPassword="True"
                                   Text="{Binding ConfirmPassword}"
                                   TextColor="White"
                                   PlaceholderColor="#E0E0E0"
                                   BackgroundColor="Transparent" />
                        </VerticalStackLayout>

                        <Button Text="Actualizar"
                                Command="{Binding CambiarCommand}"
                                Margin="0,20,0,0"
                                BackgroundColor="#5e17eb"
                                TextColor="White"
                                CornerRadius="25"
                                HeightRequest="48" />

                    </VerticalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
