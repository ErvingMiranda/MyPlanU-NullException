<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MyPlanU.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MyPlanU.App"
    xmlns:pages="clr-namespace:MyPlanU.App.Pages"
    Shell.FlyoutBehavior="Disabled">

    <ShellContent
        Title="Login"
        ContentTemplate="{DataTemplate pages:LoginPage}"
        Route="LoginPage" />

    <ShellContent
        Title="Registro"
        ContentTemplate="{DataTemplate pages:RegistroPage}"
        Route="RegistroPage" />
</Shell>